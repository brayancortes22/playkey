<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="30dp"
        android:paddingEnd="22dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/image_banner"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_playkey_banner"
            android:scaleType="fitCenter"
            android:contentDescription="PlayKey Banner" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♪  PLAYKEY"
            android:textColor="#4DD7F5"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Cambia de canción\ncon las teclas de volumen"
            android:textColor="#F5F8FF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.04" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sigue escuchando Spotify sin desbloquear el teléfono. Mantén una tecla pulsada para saltar de pista."
            android:textColor="#9BAAC0"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONTROLES"
                android:textColor="#4DD7F5"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <Switch
                android:id="@+id/switch_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:text="Controlar Spotify con volumen"
                android:textColor="#F5F8FF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/text_threshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#D4DEEC"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seek_threshold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="8"
                android:progress="3" />

            <Switch
                android:id="@+id/switch_reverse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="52dp"
                android:text="Invertir siguiente y anterior"
                android:textColor="#F5F8FF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Predeterminado: subir = siguiente · bajar = anterior. Una pulsación corta conserva el control normal del volumen."
                android:textColor="#9BAAC0"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="CONFIGURACIÓN DEL TELÉFONO"
            android:textColor="#F5F8FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Permite encontrar la sesión de Spotify"
                android:textColor="#F5F8FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_notification_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#9BAAC0"
                android:textSize="12sp" />

            <Button
                android:id="@+id/button_notification_access"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Abrir acceso multimedia"
                android:textAllCaps="false"
                android:textColor="#DDF8FF"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="#29364B" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Activa el filtro de teclas"
                android:textColor="#F5F8FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_accessibility_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#9BAAC0"
                android:textSize="12sp" />

            <Button
                android:id="@+id/button_accessibility"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Abrir ajustes de accesibilidad"
                android:textAllCaps="false"
                android:textColor="#DDF8FF"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="#29364B" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Control con pantalla apagada (Modo Bolsillo)"
                android:textColor="#F5F8FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_screen_off_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="#9BAAC0"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="4dp"
            android:text="PlayKey solo intercepta las teclas de volumen mientras Spotify tiene una sesión multimedia activa. El servicio no lee el contenido de la pantalla."
            android:textColor="#8191A8"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>
</ScrollView>
